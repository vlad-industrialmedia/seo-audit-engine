# SEO Audit Engine — Environment Variables
# Copy this file to .env.local and fill in your values
# API keys are stored client-side in localStorage — these server-side vars are optional

# Anthropic (Claude)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter (access to 100+ models)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Grok (xAI)
# Get your key at: https://console.x.ai/
GROK_API_KEY=your_grok_api_key_here

# Note: API keys entered in the Settings page are stored in browser localStorage.
# Server-side env vars above are optional and used only if you want to pre-configure the app.
